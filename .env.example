# AI-MOS Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to git

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aimosdb?schema=public

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT — Access Token (short-lived: 15m recommended) ────
JWT_ACCESS_SECRET=       # min 32 chars — use a cryptographically random value
JWT_ACCESS_EXPIRES_IN=15m

# ─── JWT — Refresh Token (long-lived: 7d recommended) ─────
JWT_REFRESH_SECRET=      # min 32 chars — different from JWT_ACCESS_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ─── Frontend (Next.js public env) ────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
