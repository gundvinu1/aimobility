# =============================================================================
# AI-MOS Environment Variables
# Copy this file to .env and fill in real values
# DO NOT commit .env to source control
# =============================================================================

# Application
NODE_ENV=development
PORT=4000

# URLs
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://aimosuser:aimospassword@localhost:5432/aimosdb?schema=public

# Redis 7
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGINS=http://localhost:3000

# JWT (placeholders - authentication is a future module)
JWT_SECRET=replace-with-a-strong-random-secret-at-least-64-chars
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret-at-least-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
