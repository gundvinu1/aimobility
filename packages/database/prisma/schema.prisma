// AI-MOS Database Schema
// Prisma version: ^5.17.0  (NOT Prisma 7)
// The `url = env("DATABASE_URL")` syntax is valid in Prisma 5.
// If your Prisma VS Code extension shows a warning about this line,
// it means the extension is running a Prisma 7 linter — ignore it.
// See: https://www.prisma.io/docs/orm/reference/prisma-schema-reference

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// AI-MOS Foundation Schema
// =============================================================================

/// Foundation audit log - tracks system-level events
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action     String
  entityType String
  entityId   String?
  userId     String?  @db.Uuid
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
  @@index([userId])
  @@map("audit_logs")
}

/// System configuration key-value store
model SystemConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("system_configs")
}

// =============================================================================
// MODULE 2 — AUTHENTICATION + RBAC
// =============================================================================

/// User account status
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

/// Platform user
model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  // Relations
  roles           UserRole[]
  refreshSessions RefreshSession[]
  passwordResets  PasswordReset[]
  emailTokens     EmailVerificationToken[]
  companies       UserCompany[]
  employees       Employee[]
  customerBookings Booking[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// Platform and Company role
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  scope       String   @default("COMPANY")
  level       Int      @default(10)
  isSystem    Boolean  @default(false)
  companyId   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       UserRole[]
  permissions RolePermission[]
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([name, companyId])
  @@index([scope])
  @@index([companyId])
  @@map("roles")
}

/// Platform permission
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  module      String?
  action      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// User ↔ Role join table
model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Role ↔ Permission join table
model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Refresh session — stores hashed refresh tokens
model RefreshSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

/// One-time password reset token (stored hashed)
model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_resets")
}

/// Email verification token (stored hashed)
model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

// =============================================================================
// MODULE 3 — COMPANY + MULTI-TENANT MANAGEMENT
// =============================================================================

/// Company (tenant) status
enum CompanyStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// Company membership role (separate from platform RBAC roles)
enum CompanyRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

/// Company membership status
enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

/// A company / tenant on the AI-MOS platform
model Company {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  legalName   String?
  slug        String        @unique
  email       String?
  phone       String?
  website     String?
  logoUrl     String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  timezone    String        @default("UTC")
  currency    String        @default("USD")
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  // Relations
  settings          CompanySettings?
  members           UserCompany[]
  invitations       CompanyInvitation[]
  employees         Employee[]
  vehicles          Vehicle[]
  drivers           Driver[]
  bookings          Booking[]
  trips             Trip[]
  roles             Role[]
  vehicleLocations  VehicleLocation[]
  vehicleTelemetry  VehicleTelemetry[]
  geofences         Geofence[]
  geofenceVehicles  GeofenceVehicle[]
  alertConfig       CompanyAlertConfig?
  fleetAlerts       FleetAlert[]
  fuelTransactions  FuelTransaction[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceRecords MaintenanceRecord[]
  workOrders        WorkOrder[]
  workOrderItems    WorkOrderItem[]
  vendors           Vendor[]
  vendorInvoices    VendorInvoice[]
  vehicleExpenses   VehicleExpense[]
  tripStops         TripStop[]

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("companies")
}

/// Company settings (1-to-1 with Company)
model CompanySettings {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @unique @db.Uuid
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  dateFormat  String   @default("DD/MM/YYYY")
  timeFormat  String   @default("HH:mm")
  language    String   @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

/// User ↔ Company membership
model UserCompany {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  companyId String           @db.Uuid
  role      CompanyRole      @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@map("user_companies")
}

/// Company invitation (token stored hashed, never in plaintext)
model CompanyInvitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String           @db.Uuid
  email       String
  role        CompanyRole      @default(MEMBER)
  tokenHash   String           @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String           @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("company_invitations")
}

// =============================================================================
// MODULE 4 — EMPLOYEE MANAGEMENT
// =============================================================================

/// Employment status
enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

/// Employment type
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERN
}

/// Employee gender
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

/// Department (extensible enum — future Department CRUD module can replace this)
enum Department {
  OPERATIONS
  DISPATCH
  ACCOUNTS
  HR
  SALES
  CUSTOMER_SUPPORT
  ADMINISTRATION
  MANAGEMENT
  OTHER
}

/// Employee — person working inside a company (distinct from User / platform identity)
model Employee {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String           @db.Uuid
  /// Optional link to a User account (an employee can exist without a login)
  userId        String?          @db.Uuid

  employeeNumber String

  // ─── Personal info ─────────────────────────────────────────────────────────
  firstName     String
  middleName    String?
  lastName      String
  displayName   String?
  gender        Gender?
  dateOfBirth   DateTime?

  // ─── Contact ───────────────────────────────────────────────────────────────
  email         String?
  phone         String
  alternatePhone String?
  profileImageUrl String?

  // ─── Address ───────────────────────────────────────────────────────────────
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?

  // ─── Employment ────────────────────────────────────────────────────────────
  department        Department?
  designation       String?
  joiningDate       DateTime
  employmentType    EmploymentType    @default(FULL_TIME)
  employmentStatus  EmploymentStatus  @default(ACTIVE)

  // ─── Emergency contact ─────────────────────────────────────────────────────
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  notes     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // ─── Relations ─────────────────────────────────────────────────────────────
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  driver  Driver?

  // Employee numbers are unique within a company (not globally)
  @@unique([companyId, employeeNumber])

  @@index([companyId])
  @@index([companyId, employmentStatus])
  @@index([companyId, department])
  @@index([companyId, createdAt])
  @@index([companyId, joiningDate])
  @@index([userId])
  @@index([deletedAt])

  @@map("employees")
}

// =============================================================================
// MODULE 5 — VEHICLE MANAGEMENT
// =============================================================================

/// Vehicle operational status
enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  RETIRED
  ON_TRIP
}

/// Vehicle fuel/propulsion type
enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  CNG
  LPG
  OTHER
}

/// Vehicle ownership type
enum VehicleOwnership {
  OWNED
  LEASED
  RENTED
}

/// Vehicle document type
enum VehicleDocumentType {
  REGISTRATION_CERTIFICATE
  INSURANCE
  POLLUTION_CERTIFICATE
  FITNESS_CERTIFICATE
  PERMIT
  TAX_TOKEN
  OTHER
}

/// Vehicle maintenance type
enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  EMERGENCY
  INSPECTION
  OTHER
}

/// Vehicle maintenance status
enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Vehicle (tenant-scoped to a company)
model Vehicle {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String          @db.Uuid

  // ─── Identity ─────────────────────────────────────────────────────────────
  vehicleNumber  String           // e.g. "MH12AB1234" — unique within company
  make           String           // e.g. "Toyota"
  model          String           // e.g. "Innova Crysta"
  year           Int              // manufacturing year
  color          String?
  vin            String?          // Vehicle Identification Number (optional global unique)

  // ─── Classification ───────────────────────────────────────────────────────
  fuelType       FuelType         @default(DIESEL)
  ownership      VehicleOwnership @default(OWNED)
  status         VehicleStatus    @default(ACTIVE)
  capacity       Int?             // seating / load capacity
  odometer       Int              @default(0)  // km
  imageUrl       String?

  // ─── Registration ─────────────────────────────────────────────────────────
  registrationExpiry  DateTime?
  insuranceExpiry     DateTime?

  notes          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // ─── Relations ────────────────────────────────────────────────────────────
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents         VehicleDocument[]
  maintenances      VehicleMaintenance[]
  driverAssignments DriverVehicleAssignment[]
  trips             Trip[]
  location          VehicleLocation?
  telemetry         VehicleTelemetry[]
  geofenceAssignments GeofenceVehicle[]
  fleetAlerts         FleetAlert[]
  fuelTransactions    FuelTransaction[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceRecords  MaintenanceRecord[]
  workOrders          WorkOrder[]
  vendorInvoices      VendorInvoice[]
  vehicleExpenses     VehicleExpense[]

  // Vehicle number is unique within a company
  @@unique([companyId, vehicleNumber])

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, fuelType])
  @@index([companyId, createdAt])
  @@index([deletedAt])

  @@map("vehicles")
}

/// Vehicle document (insurance, registration, permit, etc.)
model VehicleDocument {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId   String              @db.Uuid
  companyId   String              @db.Uuid   // denormalized for fast tenant scoping

  documentType  VehicleDocumentType
  name          String             // Human-readable document name
  documentNumber String?           // RC number, insurance policy number, etc.
  issuedAt      DateTime?
  expiresAt     DateTime?
  fileUrl       String?
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([companyId])
  @@index([expiresAt])

  @@map("vehicle_documents")
}

/// Vehicle maintenance record
model VehicleMaintenance {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId   String            @db.Uuid
  companyId   String            @db.Uuid   // denormalized for fast tenant scoping

  maintenanceType  MaintenanceType   @default(PREVENTIVE)
  status           MaintenanceStatus @default(SCHEDULED)
  description      String
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  odometerAtService Int?             // km reading at time of service
  cost             Decimal?          @db.Decimal(12, 2)
  vendor           String?           // garage / workshop name
  notes            String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([companyId])
  @@index([status])
  @@index([scheduledAt])

  @@map("vehicle_maintenances")
}

// =============================================================================
// MODULE 6 — DRIVER MANAGEMENT
// =============================================================================

/// Driver operational status
enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

/// Driver duty status for shift/dispatch operations
enum DriverDutyStatus {
  OFF_DUTY
  ON_DUTY
  ON_TRIP
  ON_BREAK
  UNAVAILABLE
}

/// Commercial driving licence classification
enum LicenseType {
  LMV
  HMV
  COMMERCIAL
  TRANSPORT
  OTHER
}

/// Driver document types
enum DriverDocumentType {
  DRIVING_LICENSE
  BADGE
  POLICE_VERIFICATION
  MEDICAL_CERTIFICATE
  IDENTITY_PROOF
  ADDRESS_PROOF
  OTHER
}

/// Driver (tenant-scoped to a company, optionally linked to an Employee)
model Driver {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId               String           @db.Uuid
  employeeId              String?          @unique @db.Uuid

  driverCode              String           // Unique within company, e.g. "DRV-001"
  licenseNumber           String           // Driver license number
  licenseType             LicenseType      @default(COMMERCIAL)
  licenseIssueDate        DateTime?
  licenseExpiryDate       DateTime
  licenseIssuingAuthority String?
  badgeNumber             String?
  badgeExpiryDate         DateTime?
  experienceYears         Int              @default(0)
  bloodGroup              String?
  emergencyContactName    String?
  emergencyContactPhone   String?
  status                  DriverStatus     @default(ACTIVE)
  dutyStatus              DriverDutyStatus @default(OFF_DUTY)
  joiningDate             DateTime         @default(now())
  notes                   String?

  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  deletedAt               DateTime?

  // Relations
  company                 Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee                Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  documents               DriverDocument[]
  dutyLogs                DriverDutyLog[]
  vehicleAssignments      DriverVehicleAssignment[]
  trips                   Trip[]
  locations               VehicleLocation[]
  telemetry               VehicleTelemetry[]
  fleetAlerts             FleetAlert[]
  fuelTransactions        FuelTransaction[]
  vehicleExpenses         VehicleExpense[]

  @@unique([companyId, driverCode])

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, dutyStatus])
  @@index([licenseExpiryDate])
  @@index([employeeId])
  @@index([deletedAt])

  @@map("drivers")
}

/// Driver document (license copy, badge, medical certificate, etc.)
model DriverDocument {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId       String             @db.Uuid
  companyId      String             @db.Uuid

  documentType   DriverDocumentType
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  fileUrl        String?
  notes          String?

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  driver         Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([companyId])
  @@index([expiryDate])
  @@index([deletedAt])

  @@map("driver_documents")
}

/// Driver shift/duty status history
model DriverDutyLog {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId   String           @db.Uuid
  companyId  String           @db.Uuid
  status     DriverDutyStatus
  startedAt  DateTime         @default(now())
  endedAt    DateTime?
  notes      String?
  createdAt  DateTime         @default(now())

  driver     Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([companyId])
  @@index([startedAt])

  @@map("driver_duty_logs")
}

/// Driver-to-Vehicle assignment record with tenant scoping
model DriverVehicleAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @db.Uuid
  driverId     String    @db.Uuid
  vehicleId    String    @db.Uuid
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  isActive     Boolean   @default(true)
  notes        String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  driver       Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([isActive])

  @@map("driver_vehicle_assignments")
}

// =============================================================================
// MODULE 7 — TRIP & BOOKING MANAGEMENT
// =============================================================================

/// Booking reservation status
enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

/// Channel/source from which booking originated
enum BookingSource {
  MANUAL
  ONLINE
  CORPORATE
  PHONE
  APP
  OTHER
}

/// Operational journey type
enum TripType {
  ONE_WAY
  ROUND_TRIP
  RENTAL
  AIRPORT_TRANSFER
  OUTSTATION
}

/// Controlled trip execution status
enum TripStatus {
  SCHEDULED
  DRIVER_ASSIGNED
  VEHICLE_ASSIGNED
  DISPATCHED
  DRIVER_ARRIVED
  PASSENGER_ONBOARD
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Booking / Reservation (tenant-scoped)
model Booking {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId               String        @db.Uuid
  customerId              String?       @db.Uuid

  bookingNumber           String        // Unique within company, e.g. "BKG-0001"
  source                  BookingSource @default(MANUAL)
  tripType                TripType      @default(ONE_WAY)

  // Customer contact details (supports registered users & guest/phone bookings)
  customerName            String
  customerPhone           String
  customerEmail           String?

  // Locations
  pickupLocation          String
  pickupAddress           String?
  pickupLatitude          Float?
  pickupLongitude         Float?
  dropLocation            String
  dropAddress             String?
  dropLatitude            Float?
  dropLongitude           Float?

  // Schedule & Estimates
  scheduledPickupAt       DateTime
  estimatedDurationMinutes Int?
  estimatedDistanceKm     Float?

  // Capacity & Requirements
  passengerCount          Int           @default(1)
  luggageCount            Int           @default(0)
  vehicleCategory         String?       // e.g. "SEDAN", "SUV", "VAN", "LUXURY"
  specialRequirements     String?

  // Status & Cancellation
  status                  BookingStatus @default(PENDING)
  cancellationReason      String?
  cancelledAt             DateTime?

  // Pricing estimate
  estimatedFare           Decimal?      @db.Decimal(12, 2)

  notes                   String?
  createdBy               String?       @db.Uuid

  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?

  // Relations
  company                 Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer                User?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  trips                   Trip[]

  @@unique([companyId, bookingNumber])

  @@index([companyId])
  @@index([companyId, status])
  @@index([scheduledPickupAt])
  @@index([customerId])
  @@index([deletedAt])

  @@map("bookings")
}

/// Operational Trip (connected to Booking, Driver, and Vehicle)
model Trip {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String             @db.Uuid
  bookingId           String             @db.Uuid
  driverId            String?            @db.Uuid
  vehicleId           String?            @db.Uuid

  tripNumber          String             // Unique within company, e.g. "TRP-0001"

  // Route & Addresses
  pickupLocation      String
  pickupAddress       String?
  pickupLatitude      Float?
  pickupLongitude     Float?
  dropLocation        String
  dropAddress         String?
  dropLatitude        Float?
  dropLongitude       Float?

  // Execution Timings
  scheduledStart      DateTime
  actualStart         DateTime?
  actualEnd           DateTime?

  // Metrics
  distanceKm          Float?
  durationMinutes     Int?
  passengerCount      Int                @default(1)

  // Status & Lifecycle
  status              TripStatus         @default(SCHEDULED)
  cancellationReason  String?
  cancelledBy         String?            @db.Uuid
  cancelledAt         DateTime?

  notes               String?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  // Relations
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  booking             Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driver              Driver?            @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle             Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  statusHistory       TripStatusHistory[]
  fleetAlerts         FleetAlert[]
  fuelTransactions    FuelTransaction[]
  vehicleExpenses     VehicleExpense[]
  routePolyline       String?
  stops               TripStop[]

  @@unique([companyId, tripNumber])

  @@index([companyId])
  @@index([companyId, status])
  @@index([bookingId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([scheduledStart])
  @@index([deletedAt])

  @@map("trips")
}

/// Immutable record of trip lifecycle state transitions
model TripStatusHistory {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId     String     @db.Uuid
  companyId  String     @db.Uuid
  fromStatus TripStatus?
  toStatus   TripStatus
  changedBy  String?    @db.Uuid
  notes      String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime   @default(now())

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([companyId])
  @@index([createdAt])

  @@map("trip_status_histories")
}

// =============================================================================
// MODULE 12 — MULTI-STOP ROUTING & DISPATCH WAYPOINTS
// =============================================================================

/// Multi-stop journey stop category
enum StopType {
  PICKUP
  WAYPOINT
  DROPOFF
}

/// Execution status for individual stop
enum StopStatus {
  PENDING
  ARRIVED
  COMPLETED
  SKIPPED
}

/// Sequenced waypoints/stops for multi-stop trips
model TripStop {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String     @db.Uuid
  tripId           String     @db.Uuid

  stopOrder        Int        // 1-indexed execution sequence
  stopType         StopType   @default(WAYPOINT)
  locationName     String
  address          String?
  latitude         Float
  longitude        Float

  plannedArrival   DateTime?
  plannedDeparture DateTime?
  actualArrival    DateTime?
  actualDeparture  DateTime?

  passengerName    String?
  passengerPhone   String?
  notes            String?
  status           StopStatus @default(PENDING)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trip             Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, stopOrder])
  @@index([companyId])
  @@index([tripId])
  @@index([status])

  @@map("trip_stops")
}

// =============================================================================
// MODULE 9 — REAL-TIME FLEET TRACKING & TELEMETRY
// =============================================================================

/// Source of telemetry data (provider-independent)
enum TelemetrySource {
  MANUAL
  MOBILE
  GPS_DEVICE
  IOT
  SIMULATOR
  API
}

/// Latest known location per vehicle (upserted on every event)
/// This is the hot-path read model for the fleet map.
model VehicleLocation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @db.Uuid
  vehicleId String    @unique @db.Uuid  // One location per vehicle
  driverId  String?   @db.Uuid

  latitude  Float
  longitude Float
  speed     Float     @default(0)     // km/h
  heading   Float?                    // degrees 0-360
  accuracy  Float?                    // metres
  altitude  Float?                    // metres
  ignition  Boolean   @default(false)

  // Optional extended telemetry
  batteryLevel      Float?   // percentage 0-100
  odometer          Int?     // km
  engineTemperature Float?   // celsius
  fuelLevel         Float?   // percentage 0-100
  signalStrength    Int?     // dBm or percentage

  source    TelemetrySource @default(API)
  timestamp DateTime        // device/event timestamp
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Relations
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, vehicleId])
  @@index([driverId])
  @@index([timestamp])

  @@map("vehicle_locations")
}

/// Historical telemetry events (append-only, bounded by time window queries)
/// Designed for future partitioning / TimescaleDB migration.
model VehicleTelemetry {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @db.Uuid
  vehicleId String    @db.Uuid
  driverId  String?   @db.Uuid

  latitude  Float
  longitude Float
  speed     Float     @default(0)
  heading   Float?
  accuracy  Float?
  altitude  Float?
  ignition  Boolean   @default(false)

  // Optional extended telemetry
  batteryLevel      Float?
  odometer          Int?
  engineTemperature Float?
  fuelLevel         Float?
  signalStrength    Int?

  source    TelemetrySource @default(API)
  timestamp DateTime        // device/event timestamp

  createdAt DateTime @default(now())

  // Relations
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([companyId, vehicleId, timestamp])
  @@index([companyId, timestamp])
  @@index([vehicleId, timestamp])
  @@index([driverId])

  @@map("vehicle_telemetry")
}

// =============================================================================
// MODULE 10 — GEOFENCING, SPEEDING & FLEET ALERT MANAGEMENT
// =============================================================================

/// Geometric boundary classification
enum GeofenceType {
  CIRCLE
  POLYGON
}

/// Operational and safety alert categories
enum FleetAlertType {
  GEOFENCE_ENTRY
  GEOFENCE_EXIT
  OVERSPEED
  HARSH_BRAKING
  EXCESSIVE_IDLE
  FUEL_DROP
  MAINTENANCE_DUE
}

/// Severity classification for fleet alerts
enum FleetAlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Operational alert workflow lifecycle
enum FleetAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

/// Geographic zone defined for fleet tracking and rule enforcement
model Geofence {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String       @db.Uuid
  name               String
  description        String?
  type               GeofenceType @default(CIRCLE)
  geometry           Json         // { center: { latitude, longitude }, radiusMeters } or { coordinates: [{ latitude, longitude }] }
  color              String       @default("#3b82f6")
  isActive           Boolean      @default(true)
  entryAlertEnabled  Boolean      @default(true)
  exitAlertEnabled   Boolean      @default(true)
  createdBy          String?      @db.Uuid
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedVehicles GeofenceVehicle[]
  alerts           FleetAlert[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("geofences")
}

/// Vehicle ↔ Geofence assignment join table
model GeofenceVehicle {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @db.Uuid
  geofenceId String   @db.Uuid
  vehicleId  String   @db.Uuid
  assignedAt DateTime @default(now())

  // Relations
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([geofenceId, vehicleId])
  @@index([companyId])
  @@index([vehicleId])
  @@index([geofenceId])
  @@map("geofence_vehicles")
}

/// Company-level configuration for alert rules and thresholds
model CompanyAlertConfig {
  id                            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                     String   @unique @db.Uuid
  overspeedEnabled              Boolean  @default(true)
  overspeedThresholdKmH         Float    @default(80.0)
  overspeedGracePeriodSeconds   Int      @default(10)
  harshBrakingEnabled           Boolean  @default(true)
  harshBrakingThresholdKmhPerSec Float   @default(20.0)
  excessiveIdleEnabled          Boolean  @default(true)
  excessiveIdleThresholdMinutes Int      @default(15)
  geofenceEntryAlertsEnabled    Boolean  @default(true)
  geofenceExitAlertsEnabled     Boolean  @default(true)
  fuelDropEnabled               Boolean  @default(true)
  fuelDropThresholdLiters       Float    @default(10.0)
  maintenanceAlertsEnabled      Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_alert_configs")
}

/// Operational and safety alert record generated by the alert engine
model FleetAlert {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String             @db.Uuid
  vehicleId       String             @db.Uuid
  driverId        String?            @db.Uuid
  tripId          String?            @db.Uuid
  geofenceId      String?            @db.Uuid
  type            FleetAlertType
  severity        FleetAlertSeverity @default(MEDIUM)
  status          FleetAlertStatus   @default(OPEN)
  title           String
  message         String
  metadata        Json?
  latitude        Float?
  longitude       Float?
  speed           Float?
  triggeredAt     DateTime           @default(now())
  acknowledgedAt  DateTime?
  acknowledgedBy  String?            @db.Uuid
  resolvedAt      DateTime?
  resolvedBy      String?            @db.Uuid
  dismissedAt     DateTime?
  dismissedBy     String?            @db.Uuid
  resolutionNotes String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Relations
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver   Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  trip     Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  geofence Geofence? @relation(fields: [geofenceId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, severity])
  @@index([companyId, type])
  @@index([vehicleId])
  @@index([driverId])
  @@index([geofenceId])
  @@index([triggeredAt])
  @@map("fleet_alerts")
}

// =============================================================================
// MODULE 11 — FUEL, MAINTENANCE, WORK ORDERS, VENDORS, INVOICES & EXPENSES
// =============================================================================

/// Source of fuel transaction record
enum FuelTransactionSource {
  MANUAL
  TELEMATICS
  FUEL_CARD
  IMPORT
}

/// Vendor / supplier classification
enum VendorType {
  SERVICE_CENTER
  MECHANIC
  FUEL_STATION
  PARTS_SUPPLIER
  OTHER
}

/// Maintenance work order urgency / priority
enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Maintenance work order lifecycle status
enum WorkOrderStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Work order line item classification
enum WorkOrderItemType {
  PARTS
  LABOR
  OTHER
}

/// Vendor invoice payment & processing status
enum VendorInvoiceStatus {
  DRAFT
  RECEIVED
  PAID
  CANCELLED
}

/// Unified fleet operating expense classification
enum VehicleExpenseCategory {
  FUEL
  MAINTENANCE
  REPAIR
  PARTS
  INSURANCE
  TAX
  TOLL
  PARKING
  CLEANING
  OTHER
}

/// Fuel purchase and refuel transaction record
model FuelTransaction {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String                @db.Uuid
  vehicleId         String                @db.Uuid
  driverId          String?               @db.Uuid
  tripId            String?               @db.Uuid
  vendorId          String?               @db.Uuid
  fuelType          FuelType              @default(DIESEL)
  quantityLiters    Float
  pricePerLiter     Float
  totalAmount       Float
  odometer          Int?
  fuelLevelBefore   Float?
  fuelLevelAfter    Float?
  transactionSource FuelTransactionSource @default(MANUAL)
  reference         String?
  stationName       String?
  transactionDate   DateTime              @default(now())
  notes             String?
  createdBy         String?               @db.Uuid
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  trip    Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, transactionDate])
  @@index([companyId, vehicleId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([tripId])
  @@index([vendorId])
  @@map("fuel_transactions")
}

/// Preventive maintenance service schedule
model MaintenanceSchedule {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String    @db.Uuid
  vehicleId           String    @db.Uuid
  serviceType         String
  description         String?
  intervalKm          Int?
  intervalDays        Int?
  lastServiceOdometer Int?
  lastServiceDate     DateTime?
  nextDueOdometer     Int?
  nextDueDate         DateTime?
  isActive            Boolean   @default(true)
  createdBy           String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle    Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  records    MaintenanceRecord[]
  workOrders WorkOrder[]

  @@index([companyId])
  @@index([companyId, vehicleId])
  @@index([companyId, isActive])
  @@index([vehicleId])
  @@index([nextDueDate])
  @@map("maintenance_schedules")
}

/// Completed maintenance service history
model MaintenanceRecord {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @db.Uuid
  vehicleId   String   @db.Uuid
  scheduleId  String?  @db.Uuid
  workOrderId String?  @db.Uuid
  vendorId    String?  @db.Uuid
  serviceType String
  odometer    Int?
  serviceDate DateTime @default(now())
  partsCost   Float    @default(0)
  laborCost   Float    @default(0)
  tax         Float    @default(0)
  totalCost   Float    @default(0)
  description String?
  notes       String?
  reference   String?
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle   Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  schedule  MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  workOrder WorkOrder?           @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  vendor    Vendor?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, serviceDate])
  @@index([vehicleId])
  @@index([scheduleId])
  @@index([workOrderId])
  @@index([vendorId])
  @@map("maintenance_records")
}

/// Third-party service centers, parts suppliers, and fuel stations
model Vendor {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String     @db.Uuid
  name          String
  type          VendorType @default(SERVICE_CENTER)
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  taxId         String?
  isActive      Boolean    @default(true)
  notes         String?
  createdBy     String?    @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fuelTransactions   FuelTransaction[]
  maintenanceRecords MaintenanceRecord[]
  workOrders         WorkOrder[]
  invoices           VendorInvoice[]
  expenses           VehicleExpense[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@index([companyId, type])
  @@map("vendors")
}

/// Maintenance work order for repairs and scheduled servicing
model WorkOrder {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String            @db.Uuid
  vehicleId          String            @db.Uuid
  vendorId           String?           @db.Uuid
  scheduleId         String?           @db.Uuid
  workOrderNumber    String
  title              String
  description        String?
  priority           WorkOrderPriority @default(MEDIUM)
  status             WorkOrderStatus   @default(DRAFT)
  assignedTechnician String?
  estimatedCost      Float             @default(0)
  actualCost         Float             @default(0)
  openedAt           DateTime          @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  notes              String?
  createdBy          String?           @db.Uuid
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle  Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vendor   Vendor?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  schedule MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  items    WorkOrderItem[]
  records  MaintenanceRecord[]
  invoices VendorInvoice[]

  @@unique([companyId, workOrderNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, priority])
  @@index([vehicleId])
  @@index([vendorId])
  @@map("work_orders")
}

/// Parts, labor, and other cost line items for a work order
model WorkOrderItem {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String            @db.Uuid
  workOrderId String            @db.Uuid
  itemType    WorkOrderItemType @default(PARTS)
  description String
  quantity    Float             @default(1)
  unitCost    Float             @default(0)
  totalCost   Float             @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workOrderId])
  @@map("work_order_items")
}

/// Vendor invoices for work orders, parts, and servicing
model VendorInvoice {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String              @db.Uuid
  vendorId      String              @db.Uuid
  vehicleId     String?             @db.Uuid
  workOrderId   String?             @db.Uuid
  invoiceNumber String
  invoiceDate   DateTime            @default(now())
  subtotal      Float               @default(0)
  tax           Float               @default(0)
  total         Float               @default(0)
  status        VendorInvoiceStatus @default(RECEIVED)
  notes         String?
  createdBy     String?             @db.Uuid
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@unique([companyId, vendorId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([vendorId])
  @@index([vehicleId])
  @@index([workOrderId])
  @@map("vendor_invoices")
}

/// Unified vehicle expense record for TCO calculations
model VehicleExpense {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String                 @db.Uuid
  vehicleId            String                 @db.Uuid
  driverId             String?                @db.Uuid
  tripId               String?                @db.Uuid
  vendorId             String?                @db.Uuid
  fuelTransactionId    String?                @db.Uuid
  maintenanceRecordId  String?                @db.Uuid
  category             VehicleExpenseCategory
  amount               Float
  date                 DateTime               @default(now())
  reference            String?
  description          String?
  source               String                 @default("MANUAL")
  createdBy            String?                @db.Uuid
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  trip    Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, date])
  @@index([companyId, category])
  @@index([vehicleId])
  @@index([driverId])
  @@index([tripId])
  @@index([vendorId])
  @@map("vehicle_expenses")
}
