{
  "name": "@ai-mos/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma database client and schema for AI-MOS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "ts-node prisma/seed.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "argon2": "^0.45.1"
  },
  "devDependencies": {
    "@ai-mos/config": "workspace:*",
    "@types/node": "^22.5.1",
    "prisma": "^5.17.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
